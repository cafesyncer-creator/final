{
  "name": "cafesync",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "build:master": "npm run build --workspace=master",
    "build:admin": "npm run build --workspace=admin",
    "build:shop": "npm run build --workspace=shop",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "seed": "tsx scripts/seed.ts",
    "seed:sql": "tsx scripts/generate-seed-sql.ts",
    "create-users": "tsx scripts/create-test-users.ts"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^20",
    "dotenv": "^18.0.10",
    "postcss": "^8.4.38",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.11",
    "typescript": "^5"
  }
}
